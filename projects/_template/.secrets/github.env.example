# Per-project GitHub token for qa-agent (gitignored as github.env).
# Used by github_create_issue.py --attach / github_attach_evidence.py (media →
# qa-evidence branch via Contents API) and preferred for gh calls.
# When set, ambient GH_TOKEN / GITHUB_TOKEN are stripped for those subprocesses.
#
# Create a fine-grained or classic PAT with:
#   - Issues: Read and write (fine-grained) / issues:write (classic) — create/comment
#   - Contents: Read and write (fine-grained) / repo (classic) — PUT on qa-evidence
# Optional for text-only evidence fallback: gist scope (secret gist).
GITHUB_TOKEN=ghp_paste_project_scoped_token_here
# Optional aliases (same value):
# GH_TOKEN=
# Optional overrides (else project.yaml tracker/git):
# GITHUB_OWNER=
# GITHUB_REPO=
